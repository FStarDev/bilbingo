{
  "name": "thin-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite",
    "dev:frontend:lan": "vite --host 0.0.0.0 --port 5173",
    "dev:backend": "tsx watch backend/src/server.ts",
    "build": "tsc && vite build && npm run build:backend",
    "build:backend": "tsc -p backend/tsconfig.json",
    "preview": "vite preview",
    "start:backend": "node backend/dist/server.js",
    "start:server": "node backend/dist/server.js",
    "task:register-server-startup": "powershell -ExecutionPolicy Bypass -File ./scripts/register-server-startup-task.ps1",
    "task:restart-server": "powershell -ExecutionPolicy Bypass -File ./scripts/restart-server-task.ps1",
    "deploy:auto-local": "powershell -ExecutionPolicy Bypass -File ./scripts/auto-deploy-local.ps1",
    "deploy:auto-local:fast": "powershell -ExecutionPolicy Bypass -File ./scripts/auto-deploy-local.ps1 -SkipInstall",
    "deploy:auto-local:task": "powershell -ExecutionPolicy Bypass -File ./scripts/auto-deploy-local.ps1 -ScheduledTaskName 'Bilbingo Server'"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.1",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
